# Copy this file to `.env` (gitignored) and fill in the values.
# pipeline/config.py loads it automatically; real environment variables win.

# >>> INSERT YOUR NORDIC AI CUP TEAM API KEY HERE <<<
# Used by nobody in this code: it's what you paste into https://cases.nordicaicup.com
# together with your endpoint URL. Kept here so it lives in one private place.
NAIC_API_KEY=

# Detector: auto | yolo | gt (local debug only) | edges | none
DETECTOR_BACKEND=auto
# DETECTOR_WEIGHTS=weights/detector.pt
# DETECTOR_IMGSZ=960
# DETECTOR_MIN_CONF=0.10

# Camera policy: greedy | hold_l0 | sweep_l1
POLICY_MODE=greedy

# Save every incoming view + our response here (useful during validation runs)
# RECORD_DIR=recordings

# Server port (the competition URL must match: http://<host>:<PORT>/predict)
# PORT=9053
